{
  "compilerOptions": {
    "target": "ES2022",
    // DOM lib を意図的に含めない (ブラウザ API に依存しないことを型検査で保証する)
    "lib": ["ES2022"],
    "types": ["vitest/globals"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "__tests__/**/*", "vitest.config.ts"]
}
